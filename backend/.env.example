# Copy to .env for local configuration. Never commit real credentials.
ENVIRONMENT=development

# Hostnames without http:// or https:// (Render's RENDER_EXTERNAL_HOSTNAME is added automatically)
# Production example: ALLOWED_HOSTS=glagahsmart-aiot-backend.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Exact frontend origins without trailing slash (comma-separated)
# Production example: CORS_ORIGINS=https://glagahsmart-aiot.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set to false in production if you want to hide /docs and /redoc
API_DOCS_ENABLED=true
